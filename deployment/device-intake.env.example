# Generate two DIFFERENT random values, each at least 32 characters.
DEVICE_INTAKE_TOKEN=CHANGE_ME
DEVICE_ADMIN_TOKEN=CHANGE_ME
ASPNETCORE_ENVIRONMENT=Production
# Separate from the existing inventory application on port 5000.
ASPNETCORE_URLS=http://127.0.0.1:5088
ConnectionStrings__DeviceIntake="Data Source=/var/lib/milife-device-intake/device-intake.db;Default Timeout=10"
Intake__CollectorPath=/opt/milife-device-intake/downloads/MiLifeDeviceCollector.exe
Intake__RequestsPerMinute=20
Intake__GlobalRequestsPerMinute=300
