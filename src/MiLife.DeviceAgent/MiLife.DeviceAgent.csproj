<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MiLifeDeviceAgent</AssemblyName><Version>1.4.0</Version>
    <ApplicationManifest>../MiLife.DeviceCollector/app.manifest</ApplicationManifest><PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MiLife.DeviceCollector/MiLife.DeviceCollector.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="agent-settings.json" Condition="Exists('agent-settings.json')" LogicalName="AgentSettings" />
    <EmbeddedResource Include="Assets/milife-logo.png" LogicalName="MiLifeLogo" />
    <EmbeddedResource Include="Uninstall.ps1" LogicalName="UninstallScript" />
  </ItemGroup>
</Project>
