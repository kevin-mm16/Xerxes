{
  "ConnectionStrings": { "DeviceIntake": "Data Source=device-intake.db;Default Timeout=10" },
  "Operations": { "BackupStatusPath": "/var/lib/milife-device-intake/last-backup.utc" },
  "Intake": {
    "CollectorPath": "downloads/MiLifeDeviceCollector.exe",
    "AllowInsecureLocalDevelopment": false,
    "RequestLimitBytes": 131072,
    "RequestsPerMinute": 20,
    "GlobalRequestsPerMinute": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
